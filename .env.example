# =============================================================================
#  AuthSec on-premise deployment — the only file you need to edit
# =============================================================================
#  cp .env.example .env && chmod 600 .env && $EDITOR .env
#
#  Both deployment methods read this same file:
#      ./deploy.sh                      Kubernetes
#      cd docker-compose && docker compose up -d
#
#  Generate every secret first:
#      ./scripts/generate-secrets.sh
# =============================================================================

# -----------------------------------------------------------------------------
#  1. DOMAIN
# -----------------------------------------------------------------------------
# Your base domain. Every hostname below defaults to a subdomain of it.
DOMAIN=example.com

# Hostnames. Change them only if you need names that are not subdomains of
# DOMAIN. Each must resolve to your ingress (Kubernetes) or the VM (Compose).
APP_HOST=app.example.com
API_HOST=api.example.com
OAUTH_HOST=oauth.example.com
# Hydra's admin API. It creates and deletes OAuth clients with NO authentication
# of its own. Leave this empty to keep it cluster-internal (recommended); set a
# hostname only if you put an authenticating proxy in front of it.
OAUTH_ADMIN_HOST=

# -----------------------------------------------------------------------------
#  2. TLS
# -----------------------------------------------------------------------------
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=ops@example.com

# prod    = real, browser-trusted certificates (rate limited)
# staging = untrusted certificates, no meaningful limits — use while testing DNS
ACME_ENV=prod

# How cert-manager proves you own the domain (Kubernetes only).
#   http01 = simplest; works with any DNS provider; cannot issue wildcards
#   dns01  = needed for wildcard certificates; requires a provider token below
ACME_SOLVER=http01

# Only for ACME_SOLVER=dns01. Currently supported: cloudflare
DNS_PROVIDER=cloudflare
DNS_API_TOKEN=
DNS_ZONE=example.com

# -----------------------------------------------------------------------------
#  3. CONTAINER IMAGES
# -----------------------------------------------------------------------------
REGISTRY=docker-repo-public.authnull.com
IMAGE_TAG=production
# Credentials supplied by AuthSec. Leave empty if your registry allows
# anonymous pulls or you created the pull secret yourself.
REGISTRY_USER=
REGISTRY_PASSWORD=

# -----------------------------------------------------------------------------
#  4. DATABASE
# -----------------------------------------------------------------------------
DB_USER=authsec
DB_NAME=authsec
# Use ./scripts/generate-secrets.sh, or avoid @ : / ? # — this goes into a URL.
DB_PASSWORD=CHANGE_ME
# Same value, percent-encoded if it contains URL-special characters
# (@ = %40, : = %3A, / = %2F, # = %23).
DB_PASSWORD_URLENCODED=CHANGE_ME
# Hydra keeps its own database on the same server.
HYDRA_DB_NAME=hydra

# Point at an external PostgreSQL (RDS, Cloud SQL, …) instead of deploying one.
# Leave empty to deploy the bundled chart.
EXTERNAL_DB_HOST=
EXTERNAL_DB_PORT=5432

# -----------------------------------------------------------------------------
#  5. OBJECT STORAGE (log archive)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=authsec
MINIO_ROOT_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
#  6. SECRETS — every one must be replaced
# -----------------------------------------------------------------------------
#  ./scripts/generate-secrets.sh fills all of these in.
JWT_SECRET=CHANGE_ME
JWT_DEF_SECRET=CHANGE_ME
JWT_SDK_SECRET=CHANGE_ME
SESSION_SECRET=CHANGE_ME
OIDC_STATE_HMAC_KEY=CHANGE_ME
TOTP_ENCRYPTION_KEY=CHANGE_ME
SYNC_CONFIG_ENCRYPTION_KEY=CHANGE_ME
# Encrypts SPIRE data at rest. Cannot be rotated without re-encrypting.
ENCRYPTION_KEY=CHANGE_ME
# Signs OAuth tokens. Changing it invalidates every issued token.
HYDRA_SECRETS_SYSTEM=CHANGE_ME
HYDRA_SECRETS_COOKIE=CHANGE_ME
HYDRA_PAIRWISE_SALT=CHANGE_ME
# Vault's userpass login created during initialisation.
VAULT_USERNAME=vaultadmin
VAULT_PASSWORD=CHANGE_ME
# Docker Compose only: filled in by docker-compose/vault-init.sh after first run.
VAULT_TOKEN=

# -----------------------------------------------------------------------------
#  7. EMAIL (optional — needed for verification and invitation mail)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
#  8. KUBERNETES PLACEMENT (ignored by Docker Compose)
# -----------------------------------------------------------------------------
# Namespaces are created if missing. Releases keep their plain names so service
# DNS stays short, e.g. postgresql-primary.<NS_DATABASE>.svc.cluster.local
NS_DATABASE=authsec-data
NS_VAULT=authsec-vault
NS_HYDRA=authsec-oauth
NS_LOGGING=authsec-logging
NS_APP=authsec
NS_INGRESS=ingress-nginx
NS_CERTMGR=cert-manager

REL_POSTGRES=postgresql
REL_VAULT=vault
REL_HYDRA=hydra
REL_FLUENTBIT=fluent-bit
REL_APP=authsec

# Your cluster's ingress class and StorageClass. Empty StorageClass = cluster default.
INGRESS_CLASS=nginx
STORAGE_CLASS=

# Deploy a PostgreSQL read replica alongside the primary.
POSTGRES_REPLICATION=false

# Path to the kubeconfig for the target cluster. Empty = your current context.
KUBECONFIG_PATH=
