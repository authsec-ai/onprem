# Caddy obtains and renews Let's Encrypt certificates automatically. The only
# requirement is that ports 80 and 443 are reachable from the internet and the
# DNS records below point at this host.
{
	email {$ACME_EMAIL}
}

# Web UI
{$APP_HOST} {
	encode gzip
	reverse_proxy ui:3000
}

# AuthSec API
{$API_HOST} {
	encode gzip
	reverse_proxy authsec:4331
}

# OAuth2 / OIDC public endpoints (discovery, authorize, token, jwks)
{$OAUTH_HOST} {
	encode gzip
	reverse_proxy hydra:4444
}

# Hydra's ADMIN API (port 4445) is deliberately NOT published. It can create
# and delete OAuth clients with no authentication of its own; it must stay on
# the internal network. Reach it with:
#   docker compose exec hydra hydra list clients --endpoint http://127.0.0.1:4445
